# Production Caddy block for trigamedev.org
# Caddy automatically provisions Let's Encrypt HTTPS certificates once DNS points to 129.121.165.252.

trigamedev.org, www.trigamedev.org {
	encode zstd gzip

	# Shared Go API (TriGameDev Auth, Key Vault, Ebook Library, CMS)
	handle_path /api/go/* {
		reverse_proxy api-go:8080
	}

	# Shared FastAPI (Python utilities / AI services)
	handle_path /api/py/* {
		reverse_proxy api-fastapi:8000
	}

	# Static Vue 3 + Tailwind SPA
	handle {
		root * /srv/sites/trigamedev.org
		try_files {path} /index.html
		file_server
	}
}
